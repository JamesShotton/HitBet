{
    "name": "arb-saas",
    "private": true,
    "workspaces": [
      "apps/*",
      "packages/*"
    ],
    "scripts": {
      "dev:web": "npm --workspace apps/web run dev",
      "dev:worker": "npm --workspace apps/worker run dev",
      "dev": "concurrently -n web,worker \"npm run dev:web\" \"npm run dev:worker\"",
      "build:web": "npm --workspace apps/web run build"
    },
    "devDependencies": {
      "concurrently": "^9.0.0"
    },
    "dependencies": {
      "@auth/pg-adapter": "^1.1.1",
      "@stripe/react-stripe-js": "^5.6.1",
      "@stripe/stripe-js": "^8.9.0",
      "next": "^16.1.6",
      "stripe": "^20.4.0"
    }
  }